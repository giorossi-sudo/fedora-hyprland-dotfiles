#
# ATTENZIONE (Fedora + GNOME):
# NON copiare questo file in /etc/environment se usi GNOME o GDM!
# Altrimenti XDG_CURRENT_DESKTOP sovrascriverà l'ambiente GNOME globale mandandolo in crash.
#
# Le variabili essenziali per Hyprland sono già state integrate direttamente
# dentro ~/.config/hypr/hyprland.conf con la sintassi 'env = NOME,valore'.
#
# Questo file viene fornito solo come riferimento storico del setup originale di Riccardo Palombo.
#

BROWSER=firefox
EDITOR=micro
QT_QPA_PLATFORMTHEME=qt5ct
QT_PLATFORM_PLUGIN=qt5ct
QT_PLATFORMTHEME=qt5ct
QT_QPA_PLATFORM=wayland
QT_WAYLAND_DISABLE_WINDOWDECORATION=1
QT_AUTO_SCREEN_SCALE_FACTOR=1
XDG_CURRENT_DESKTOP=Hyprland
XDG_SESSION_DESKTOP=Hyprland
XDG_SESSION_TYPE=wayland
MOZ_ENABLE_WAYLAND=1
CLUTTER_BACKEND=wayland
ECORE_EVAS_ENGINE=wayland
ELM_ENGINE=wayland
SDL_VIDEODRIVER=wayland
_JAVA_AWT_WM_NONREPARENTING=1
NO_AT_BRIDGE=1
GDK_BACKEND=wayland
LIBSEAT_BACKEND=logind

COINMARKETCAP_API_KEY=
