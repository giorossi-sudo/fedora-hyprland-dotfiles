#!/usr/bin/bash
#
# Script di autostart per Hyprland (Fedora con GNOME)
# Basato sulla configurazione di Riccardo Palombo (https://riccardo.im)
#

# Configurazione socket per wob (On-screen display luminosità e volume)
export SWAYSOCK="$XDG_RUNTIME_DIR"
rm -f "$SWAYSOCK.wob"
mkfifo "$SWAYSOCK.wob"
tail -f "$SWAYSOCK.wob" | wob &

# Notifiche
mako &

# Demone terminale foot
foot --server &

# Sfondo desktop (lanciato tramite hyprctl per avere il contesto Wayland corretto)
if [ -f "$HOME/Pictures/zenbook-diagonale-rossa-su-nero.png" ]; then
    hyprctl dispatch exec "swaybg -i $HOME/Pictures/zenbook-diagonale-rossa-su-nero.png -m fill"
fi

# Blocco schermo, spegnimento display OLED (2 min) e sospensione (8 min)
killall swayidle 2>/dev/null
swayidle -w \
    timeout 120 'hyprctl dispatch dpms off' \
    resume 'hyprctl dispatch dpms on' \
    timeout 480 'systemctl suspend' \
    before-sleep 'hyprctl dispatch dpms off' &

# Barre di stato Waybar
if [ -f "$HOME/scripts/waybar_top.sh" ]; then
    "$HOME/scripts/waybar_top.sh" &
fi
if [ -f "$HOME/scripts/waybar_bottom.sh" ]; then
    "$HOME/scripts/waybar_bottom.sh" &
fi

# Polkit Authentication Agent (Fallback robusto per Fedora GNOME / KDE / MATE)
if [ -f /usr/libexec/polkit-mate-authentication-agent-1 ]; then
    /usr/libexec/polkit-mate-authentication-agent-1 &
elif [ -f /usr/libexec/polkit-gnome-authentication-agent-1 ]; then
    /usr/libexec/polkit-gnome-authentication-agent-1 &
elif [ -f /usr/libexec/kf6/polkit-kde-authentication-agent-1 ]; then
    /usr/libexec/kf6/polkit-kde-authentication-agent-1 &
elif [ -f /usr/libexec/kf5/polkit-kde-authentication-agent-1 ]; then
    /usr/libexec/kf5/polkit-kde-authentication-agent-1 &
elif [ -f /usr/lib/polkit-kde-authentication-agent-1 ]; then
    /usr/lib/polkit-kde-authentication-agent-1 &
fi

# Sincronizzazione variabili sessione con DBus e Systemd utente
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP &
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP &

# Impostazioni interfaccia desktop e font
gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita' &
gsettings set org.gnome.desktop.interface font-name 'JetBrains Mono 11' &
gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' &
gsettings set org.cinnamon.desktop.default-applications.terminal exec footclient 2>/dev/null &
